<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime blocks Apple events unless this is set. island
         scripts cmux / Ghostty / Terminal / iTerm2 (through osascript) to
         focus the tab running a task. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
